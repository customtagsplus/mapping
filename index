        </div>
        
        <div class="flex flex-wrap items-center gap-3 mt-2 sm:mt-0">
            <!-- Dynamic Driver Selector Layout -->
            <select id="driver-selector" class="bg-gray-700 text-white text-sm rounded-lg px-3 py-2 border border-gray-600 focus:outline-none focus:border-emerald-500">
                <option value="viewer">🛰️ Viewer / Dispatcher Mode</option>
                <option value="driver_1" id="opt-driver_1">🚗 Driver 1 (Neon Cyan)</option>
                <option value="driver_2" id="opt-driver_2">🚙 Driver 2 (Hot Pink)</option>
                <option value="driver_3" id="opt-driver_3">🚚 Driver 3 (Lime Green)</option>
                <option value="driver_4" id="opt-driver_4">🚛 Driver 4 (Bright Orange)</option>
            </select>

            <button id="action-btn" class="hidden bg-emerald-600 hover:bg-emerald-500 text-white px-4 py-2 rounded-lg font-medium text-sm transition-all shadow-md">
                Start Driving
            </button>
            
            <button id="admin-btn" class="bg-amber-600 hover:bg-amber-500 text-white px-4 py-2 rounded-lg font-medium text-sm transition-all shadow-md">
                ⚙️ Admin Panel
            </button>

            <button id="share-btn" class="bg-gray-700 hover:bg-gray-600 text-white px-4 py-2 rounded-lg font-medium text-sm transition-all border border-gray-600">
                🔗 Copy Link
            </button>
        </div>
    </header>

    <!-- Admin Overlay Panel Element -->
    <div id="admin-panel" class="hidden absolute top-20 right-6 bg-gray-800 border border-amber-500/40 p-5 rounded-xl shadow-2xl z-30 w-80 backdrop-blur-md">
        <div class="flex justify-between items-center mb-4">
            <h2 class="text-amber-400 font-bold text-base">Secure Settings</h2>
            <button id="close-admin" class="text-gray-400 hover:text-white text-sm">✕ Close</button>
        </div>
        
        <!-- Fleet Naming Interface -->
        <div class="space-y-2 mb-4">
            <label class="text-xs text-gray-400 uppercase tracking-wider block font-semibold">Rename Live Fleet Profiles</label>
            <div class="flex gap-2">
                <select id="admin-driver-pick" class="bg-gray-700 text-xs rounded px-2 py-1 flex-1 text-white border border-gray-600">
                    <option value="driver_1">Driver 1</option>
                    <option value="driver_2">Driver 2</option>
                    <option value="driver_3">Driver 3</option>
                    <option value="driver_4">Driver 4</option>
                </select>
                <input id="new-name-input" type="text" placeholder="Enter name" class="bg-gray-900 border border-gray-700 rounded px-2 py-1 text-xs text-white w-28 focus:border-amber-500 focus:outline-none">
                <button id="save-name-btn" class="bg-amber-600 hover:bg-amber-500 px-2 py-1 text-xs font-semibold rounded">Save</button>
            </div>
        </div>

        <hr class="border-gray-700 my-4">

        <!-- Master Data Destruction System -->
        <div>
            <label class="text-xs text-gray-400 uppercase tracking-wider block font-semibold mb-2">Destructive Master Controls</label>
            <button id="wipe-btn" class="w-full bg-rose-700 hover:bg-rose-600 text-white text-xs font-bold py-2.5 rounded-lg transition-all shadow-md">
                🚨 Wipe Entire Fleet Trails
            </button>
        </div>
    </div>

    <!-- Map Canvas Dashboard Framework -->
    <main class="flex-1 relative flex flex-col md:flex-row">
        <div id="map" class="flex-1 h-full"></div>

        <!-- Metric Stream Feedback Sidebar Panel -->
        <div class="w-full md:w-80 bg-gray-800 border-t md:border-t-0 md:border-l border-gray-700 p-4 overflow-y-auto max-h-48 md:max-h-full">
            <h3 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">Live Fleet Board</h3>
            <div id="fleet-list" class="space-y-3">
                <p id="no-drivers-text" class="text-sm text-gray-500 italic">No active driver feeds detected.</p>
            </div>
        </div>
    </main>

